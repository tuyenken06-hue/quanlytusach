<%- include('partials/header', { title: 'Hồ Sơ Của Tôi' }) %>

<style>
    .profile-header {
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: white;
        border-radius: 20px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }
    .profile-avatar-big {
        width: 120px;
        height: 120px;
        background-color: white;
        color: #2563eb;
        font-size: 3rem;
        font-weight: 800;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .book-card-small {
        transition: all 0.3s ease;
    }
    .book-card-small:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 25px rgba(0,0,0,0.1);
    }
</style>

<main class="container py-5">
    <div class="profile-header text-center">
        <div class="profile-avatar-big mx-auto mb-3">
            <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <h2 class="fw-bold mb-1"><%= user.username %></h2>
        <p class="mb-0 opacity-75">Thành viên từ <%= user.createdAt ? new Date(user.createdAt).getFullYear() : '2026' %></p>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-3">
                <i class="bi bi-book-fill me-2"></i>
                Sách đã mua (<%= books ? books.length : 0 %>)
            </h4>
        </div>
    </div>

    <div class="row g-4">
        <% if (books && books.length > 0) { %>
            <% books.forEach(book => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="book-card-small card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-primary"><%= book.category || 'Chưa phân loại' %></span>
                                <span class="fw-bold text-primary"><%= book.price ? book.price.toLocaleString('vi-VN') : 0 %> đ</span>
                            </div>
                            
                            <h5 class="card-title fw-bold text-dark"><%= book.title %></h5>
                            <p class="text-muted small"><%= book.author %></p>
                            
                            <a href="/books/read/<%= book._id %>" class="btn btn-primary w-100 mt-3">
                                <i class="bi bi-book-fill"></i> Đọc sách
                            </a>
                        </div>
                        <div class="card-footer bg-light border-0 text-secondary small">
                            Năm xuất bản: <%= book.publishYear || 'N/A' %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="bi bi-book display-1 text-muted mb-3"></i>
                <h5 class="text-muted">Bạn chưa mua sách nào</h5>
                <a href="/books" class="btn btn-outline-primary mt-3">Khám phá sách ngay</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>