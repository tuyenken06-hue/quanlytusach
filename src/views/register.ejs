<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản</title>
    <link rel="stylesheet" href="/stylesheets/signup.css" />
</head>

<body>
    <div class="signup-container">
        <div class="logo-wrapper">
            <img src="/images/Logo.svg" alt="Logo" class="signup-logo" />
        </div>

        <h2 class="signup-title">Tạo tài khoản mới</h2>

        <% if (errors?.general) { %>
            <div class="error-box">
                <%= errors.general %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <div class="form-group">
                <label>Email</label>
                <input 
                    class="signup-input <%= errors?.email ? 'input-error' : '' %>" 
                    type="email" 
                    name="email" 
                    placeholder="Nhập email của bạn"
                    value="<%= oldData?.email || '' %>"
                />
                <% if (errors?.email) { %>
                    <p class="field-error"><%= errors.email %></p>
                <% } %>
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                <input 
                    class="signup-input <%= errors?.password ? 'input-error' : '' %>" 
                    type="password" 
                    name="password" 
                    placeholder="Tối thiểu 6 ký tự"
                />
                <% if (errors?.password) { %>
                    <p class="field-error"><%= errors.password %></p>
                <% } %>
            </div>

            <div class="form-group">
                <label>Xác nhận mật khẩu</label>
                <input
                    class="signup-input <%= errors?.confirm_password ? 'input-error' : '' %>"
                    type="password"
                    name="confirm_password"
                    placeholder="Nhập lại mật khẩu"
                />
                <% if (errors?.confirm_password) { %>
                    <p class="field-error"><%= errors.confirm_password %></p>
                <% } %>
            </div>

            <button class="signup-btn" type="submit">Đăng ký ngay</button>
        </form>

        <p class="signup-link">
            Đã có tài khoản? <a href="/login">Đăng nhập tại đây</a>
        </p>
    </div>
</body>
</html>