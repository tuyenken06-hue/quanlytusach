<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TuSach</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">

    <style>
        .profile-avatar {
            width: 40px;
            height: 40px;
            background-color: #5fb8e5;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 10px rgba(95, 184, 229, 0.2);
        }

        .profile-avatar:hover {
            transform: scale(1.1);
        }

        .dropdown-menu {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        /* Style cho mục New Book nổi bật */
        .nav-link.new-book-link {
            color: #2563eb !important;
            font-weight: 700;
            position: relative;
        }
        .nav-link.new-book-link::after {
            content: 'NEW';
            position: absolute;
            top: -5px;
            right: -15px;
            font-size: 0.6rem;
            background: #ef4444;
            color: white;
            padding: 1px 4px;
            border-radius: 4px;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
        <div class="container">
            <a href="/">
                <img src="/images/Logo.svg" width="90" alt="Logo" />
            </a>

            <ul class="navbar-nav ms-4 me-auto">
                <li class="nav-item">
                    <a class="nav-link <%= (typeof title !== 'undefined' && title === 'Home') ? 'active' : '' %>" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= (typeof title !== 'undefined' && title === 'Bookcase') ? 'active' : '' %>" href="/books">Bookcase</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link new-book-link <%= (typeof title !== 'undefined' && title === 'New Books') ? 'active' : '' %>" href="/books/new">New Book</a>
                </li>
            </ul>

            <div class="search-box d-none d-md-block">
                <input type="text" placeholder="Search..." />
                <img src="/images/icontimkiem.png" alt="Search" />
            </div>

            <div class="ms-3 d-flex gap-2 align-items-center">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="dropdown">
                        <button class="profile-avatar dropdown-toggle border-0" 
                                type="button" 
                                id="userDropdown" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false">
                            <%= (user.username) ? user.username.charAt(0).toUpperCase() : 'T' %>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow mt-3" aria-labelledby="userDropdown">
                            <li><h6 class="dropdown-header text-muted">Chào, <%= user.username %>!</h6></li>
                            <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-person me-2"></i>Hồ sơ của tôi</a></li>
                            <li><a class="dropdown-item py-2" href="/books"><i class="bi bi-book me-2"></i>Tủ sách cá nhân</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn btn-login text-decoration-none">Login</a>
                    <a href="/register" class="btn btn-outline-dark rounded-pill px-4 text-decoration-none">Sign up</a>
                <% } %>
            </div>
        </div>
    </nav>