<%- include('partials/header', { title: 'Tủ Sách Của Bạn' }) %>

<style>
    :root {
        --brand-primary: #2563eb;
        --brand-dark: #0f172a;
        --bg-soft: #f8fafc;
        --border-soft: #e2e8f0;
    }

    body { background-color: var(--bg-soft); color: #334155; }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -1.5px;
        color: var(--brand-dark);
    }

    .btn-primary-custom {
        background-color: var(--brand-dark);
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-primary-custom:hover {
        background-color: #334155;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.1);
        color: white;
    }

    .filter-pills {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 8px;
    }
    .filter-link {
        background: white;
        border: 1px solid var(--border-soft);
        color: #64748b;
        padding: 8px 20px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 500;
        transition: 0.3s;
        white-space: nowrap;
    }
    .filter-link:hover {
        border-color: var(--brand-primary);
        color: var(--brand-primary);
    }
    .filter-link.active {
        background: var(--brand-primary);
        color: white;
        border-color: var(--brand-primary);
    }

    .book-card {
        background: white;
        border: 1px solid var(--border-soft);
        border-radius: 20px;
        padding: 24px;
        height: 100%;
        transition: all 0.3s ease;
    }
    .book-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 30px rgba(0, 0, 0, 0.04);
        border-color: var(--brand-primary);
    }

    .status-tag {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .status-reading { background: #eff6ff; color: #1e40af; }
    .status-done { background: #f0fdf4; color: #166534; }
    .status-wish { background: #fff7ed; color: #9a3412; }

    /* Xóa bỏ các chấm đen và tinh chỉnh menu */
    .custom-dropdown {
        position: relative;
    }
    .custom-dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        z-index: 1000;
        min-width: 160px;
        background: white;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        border-radius: 16px;
        border: 1px solid var(--border-soft);
        margin-top: 8px;
        padding: 6px 0;
        list-style: none; /* Ẩn các chấm list mặc định */
    }
    .custom-dropdown-menu.show {
        display: block;
    }
    
    .custom-dropdown-menu li {
        list-style: none !important; /* Ghi đè triệt để thuộc tính list */
    }

    .modal-content-premium {
        border-radius: 24px;
        border: none;
        overflow: hidden;
    }
    .input-premium {
        background: #f1f5f9;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 12px 16px;
    }
    .input-premium:focus {
        background: white;
        border-color: var(--brand-primary);
        box-shadow: none;
    }
</style>

<main class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-7">
            <h1 class="hero-title mb-2">Không gian đọc của bạn</h1>
            <p class="text-secondary fs-5">Chào mừng bạn trở lại. Hãy cùng chúng tôi lưu giữ những trang sách giá trị hôm nay.</p>
        </div>
        <div class="col-md-5 text-md-end">
            <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addBookModal">
                <i class="bi bi-journal-plus me-2"></i> Thêm vào kệ sách
            </button>
        </div>
    </div>

    <% let current = (typeof currentFilter !== 'undefined') ? currentFilter : 'All'; %>
    <div class="filter-pills mb-5">
        <a href="/books" class="filter-link <%= current === 'All' ? 'active' : '' %>">
            <i class="bi bi-grid-1x2-fill me-2"></i> Tất cả sách
        </a>
        <a href="/books?status=Đang đọc" class="filter-link <%= current === 'Đang đọc' ? 'active' : '' %>">
            <i class="bi bi-book-half me-2"></i> Bạn đang đọc
        </a>
        <a href="/books?status=Đã xong" class="filter-link <%= current === 'Đã xong' ? 'active' : '' %>">
            <i class="bi bi-check-circle-fill me-2"></i> Bạn đã đọc
        </a>
        <a href="/books?status=Muốn mua" class="filter-link <%= current === 'Muốn mua' ? 'active' : '' %>">
            <i class="bi bi-heart-fill me-2"></i> Danh sách mong đợi
        </a>
    </div>

    <div class="row g-4">
        <% if (typeof books !== 'undefined' && books.length > 0) { %>
            <% books.forEach(book => { %>
                <div class="col-md-6 col-lg-3">
                    <div class="book-card d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <% if(book.status === 'Đang đọc') { %>
                                <span class="status-tag status-reading"><i class="bi bi-play-circle-fill"></i> Đang đọc</span>
                            <% } else if(book.status === 'Đã xong') { %>
                                <span class="status-tag status-done"><i class="bi bi-check-all"></i> Đã xong</span>
                            <% } else { %>
                                <span class="status-tag status-wish"><i class="bi bi-star-fill"></i> Muốn mua</span>
                            <% } %>

                            <div class="custom-dropdown">
                                <button class="btn btn-sm btn-light rounded-circle btn-custom-toggle" type="button">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="custom-dropdown-menu">
                                    <li>
                                        <a class="dropdown-item py-2" href="#" data-bs-toggle="modal" data-bs-target="#editBookModal<%= book._id %>">
                                            <i class="bi bi-pencil-square me-2"></i> Chỉnh sửa
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form action="/books/delete/<%= book._id %>" method="POST" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 text-danger border-0 w-100 text-start" onclick="return confirm('Bạn có chắc chắn muốn gỡ cuốn sách này không?');">
                                                <i class="bi bi-trash3-fill me-2"></i> Gỡ khỏi kệ
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-1"><%= book.title %></h5>
                        <p class="text-muted small">Tác giả: <span class="fw-medium"><%= book.author %></span></p>
                        
                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center text-secondary">
                            <span class="small"><i class="bi bi-calendar-check me-2"></i><%= book.publishYear %></span>
                            <i class="bi bi-arrow-up-right-circle opacity-25"></i>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="editBookModal<%= book._id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content modal-content-premium shadow-lg">
                            <form action="/books/edit/<%= book._id %>" method="POST">
                                <div class="modal-header border-0 pt-4 px-4">
                                    <h5 class="modal-title fw-bold">Chỉnh sửa thông tin sách</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary text-uppercase">Tên tác phẩm</label>
                                        <input type="text" name="title" value="<%= book.title %>" class="form-control input-premium" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary text-uppercase">Tác giả</label>
                                        <input type="text" name="author" value="<%= book.author %>" class="form-control input-premium" required>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="form-label small fw-bold text-secondary text-uppercase">Năm xuất bản</label>
                                            <input type="number" name="publishYear" value="<%= book.publishYear %>" class="form-control input-premium">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-bold text-secondary text-uppercase">Tình trạng đọc</label>
                                            <select name="status" class="form-select input-premium">
                                                <option value="Muốn mua" <%= book.status === 'Muốn mua' ? 'selected' : '' %>>Dự định mua</option>
                                                <option value="Đang đọc" <%= book.status === 'Đang đọc' ? 'selected' : '' %>>Đang trải nghiệm</option>
                                                <option value="Đã xong" <%= book.status === 'Đã xong' ? 'selected' : '' %>>Đã hoàn thành</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pb-4 px-4 d-flex gap-2">
                                    <button type="button" class="btn btn-light rounded-3 px-4 py-2" data-bs-dismiss="modal">Hủy bỏ</button>
                                    <button type="submit" class="btn-primary-custom px-4 py-2">Cập nhật</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <div class="bg-white p-5 rounded-5 border-2 border-dashed d-inline-block shadow-sm">
                    <i class="bi bi-journals display-1 text-muted opacity-25"></i>
                    <h4 class="mt-4 fw-bold">Kệ sách của bạn đang mở</h4>
                    <p class="text-secondary mb-4">Hãy để chúng tôi giúp bạn quản lý những cuốn sách yêu thích.</p>
                    <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addBookModal">Bắt đầu ngay</button>
                </div>
            </div>
        <% } %>
    </div>
</main>

<div class="modal fade" id="addBookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-premium shadow-lg">
            <form action="/books/add" method="POST">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Thêm sách mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Tên tác phẩm</label>
                        <input type="text" name="title" class="form-control input-premium" placeholder="Nhập tên sách..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Tác giả</label>
                        <input type="text" name="author" class="form-control input-premium" placeholder="Tên tác giả..." required>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Năm xuất bản</label>
                            <input type="number" name="publishYear" class="form-control input-premium" placeholder="2026">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Tình trạng đọc</label>
                            <select name="status" class="form-select input-premium">
                                <option value="Muốn mua">Dự định mua</option>
                                <option value="Đang đọc" selected>Đang trải nghiệm</option>
                                <option value="Đã xong">Đã hoàn thành</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 px-4 d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-3 px-4 py-2" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn-primary-custom px-4 py-2">Lưu vào kệ sách</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.btn-custom-toggle').forEach(toggle => {
            toggle.addEventListener('click', function(e) {
                e.stopPropagation();
                
                // Ẩn tất cả dropdown menu khác
                document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
                    if (menu !== toggle.nextElementSibling) {
                        menu.classList.remove('show');
                    }
                });
                
                toggle.nextElementSibling.classList.toggle('show');
            });
        });

        // Click ra ngoài khoảng trống sẽ ẩn menu
        window.addEventListener('click', function() {
            document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
                menu.classList.remove('show');
            });
        });
    });
</script>