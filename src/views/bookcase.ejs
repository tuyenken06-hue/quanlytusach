<%- include('partials/header', { title: 'Tủ Sách Của Bạn' }) %>

<style>
    :root {
        --brand-primary: #2563eb;
        --brand-dark: #0f172a;
        --bg-soft: #f8fafc;
        --border-soft: #e2e8f0;
    }

    body { background-color: var(--bg-soft); color: #334155; }

    .hero-title {
        font-size: 2.5rem; font-weight: 800; letter-spacing: -1.5px; color: var(--brand-dark);
    }

    .btn-primary-custom {
        background-color: var(--brand-dark); color: white; border: none;
        padding: 12px 28px; border-radius: 12px; font-weight: 600; transition: all 0.3s ease;
    }
    .btn-primary-custom:hover { background-color: #334155; transform: translateY(-2px); color: white; }

    .filter-pills { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
    .filter-link {
        background: white; border: 1px solid var(--border-soft); color: #64748b;
        padding: 8px 20px; border-radius: 50px; text-decoration: none;
        font-weight: 500; transition: 0.3s; white-space: nowrap; display: flex; align-items: center;
    }
    .filter-link:hover { border-color: var(--brand-primary); color: var(--brand-primary); }
    .filter-link.active { background: var(--brand-primary) !important; color: white !important; border-color: var(--brand-primary); }

    .book-card {
        background: white; border: 1px solid var(--border-soft); border-radius: 20px;
        padding: 24px; height: 100%; transition: all 0.3s ease;
        display: flex; flex-direction: column; position: relative;
    }
    .book-card:hover { transform: translateY(-8px); box-shadow: 0 20px 30px rgba(0, 0, 0, 0.04); border-color: var(--brand-primary); }

    .book-price-tag {
        background: rgba(37, 99, 235, 0.1); color: var(--brand-primary);
        font-weight: 800; padding: 6px 14px; border-radius: 8px; font-size: 0.95rem;
        white-space: nowrap;          /* ← Sửa lỗi xuống dòng */
    }

    .custom-dropdown { position: relative; }
    .btn-custom-toggle { 
        width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
        border: none; background: #f1f5f9; color: #64748b; transition: 0.2s; cursor: pointer;
        border-radius: 50%;
    }
    .btn-custom-toggle:hover { background: var(--brand-primary); color: white; }
    
    .custom-dropdown-menu {
        display: none; position: absolute; right: 0; top: 100%; z-index: 1000;
        min-width: 170px; background: white; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-radius: 12px; border: 1px solid var(--border-soft); margin-top: 8px; 
        padding: 5px 0; list-style: none;
    }
    .custom-dropdown-menu.show { display: block; }

    .dropdown-item { 
        padding: 10px 16px; font-size: 0.9rem; font-weight: 500; color: #334155; 
        text-decoration: none; display: flex; align-items: center; gap: 10px;
        width: 100%; border: none; background: none; text-align: left; transition: 0.2s;
    }
    .dropdown-item:hover { background: #f8fafc; color: var(--brand-primary); }

    .btn-read-now, .btn-buy-now {
        padding: 10px 16px;
        font-weight: 700; font-size: 0.95rem;
        border-radius: 10px; width: 100%; text-align: center;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        margin-bottom: 8px;
    }
    .btn-read-now {
        background: var(--brand-primary); color: white;
    }
    .btn-read-now:hover { background: #1d4ed8; color: white; }

    .btn-buy-now {
        background: white; color: #2563eb; border: 2px solid #2563eb;
    }
    .btn-buy-now:hover {
        background: #2563eb; color: white;
    }

    .status-select-tag {
        font-size: 0.8rem;
        font-weight: 700;
        height: 34px;
        padding: 0 12px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
    }
    .status-reading { background: #dbeafe; color: #1e40af; }
    .status-done    { background: #dcfce7; color: #166534; }
    .status-wish    { background: #fef3c7; color: #92400e; }
</style>

<main class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-7">
            <h1 class="hero-title mb-2">TỦ SÁCH CỦA BẠN</h1>
            <p class="text-secondary fs-5">Khám phá và quản lý sách cá nhân</p>
        </div>
        <% if (isAdmin) { %>
        <div class="col-md-5 text-md-end">
            <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addBookModal">
                Thêm sách mới
            </button>
        </div>
        <% } %>
    </div>

    <% let current = (typeof currentFilter !== 'undefined') ? currentFilter : 'All'; %>
    <div class="filter-pills mb-5">
        <a href="/books" class="filter-link <%= current === 'All' ? 'active' : '' %>">Tất cả</a>
        <a href="/books?category=Công nghệ" class="filter-link <%= current === 'Công nghệ' ? 'active' : '' %>">Công nghệ</a>
        <a href="/books?category=Kinh tế" class="filter-link <%= current === 'Kinh tế' ? 'active' : '' %>">Kinh tế</a>
        <a href="/books?category=Văn học" class="filter-link <%= current === 'Văn học' ? 'active' : '' %>">Văn học</a>
    </div>

    <div class="row g-4">
        <% if (typeof books !== 'undefined' && books.length > 0) { %>
            <% books.forEach(book => { %>
                <div class="col-md-6 col-lg-3">
                    <div class="book-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <% if (!isAdmin) { %>
                                <form action="/books/update-status/<%= book._id %>" method="POST" class="mb-0">
                                    <select name="status" class="status-select-tag 
                                        <%= book.status === 'Đang đọc' ? 'status-reading' : 
                                           book.status === 'Đã xong' ? 'status-done' : 'status-wish' %>"
                                        onchange="this.form.submit()">
                                        <option value="Muốn mua" <%= book.status === 'Muốn mua' ? 'selected' : '' %>>Muốn mua</option>
                                        <option value="Đang đọc" <%= book.status === 'Đang đọc' ? 'selected' : '' %>>Đang đọc</option>
                                        <option value="Đã xong" <%= book.status === 'Đã xong' ? 'selected' : '' %>>Đã xong</option>
                                    </select>
                                </form>
                            <% } else { %>
                                <span class="badge bg-light text-dark border"><%= book.status || 'Chưa có' %></span>
                            <% } %>

                            <div class="book-price-tag">
                                <%= book.price ? book.price.toLocaleString('vi-VN') : 0 %> đ
                            </div>

                            <% if (isAdmin) { %>
                            <div class="custom-dropdown">
                                <button class="btn-custom-toggle rounded-circle" type="button">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="custom-dropdown-menu shadow">
                                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editBookModal<%= book._id %>"><i class="bi bi-pencil-square"></i> Sửa</button></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form action="/books/delete/<%= book._id %>?_method=DELETE" method="POST" class="m-0">
                                            <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Xóa sách này?')"><i class="bi bi-trash3"></i> Xóa</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            <% } %>
                        </div>

                        <h5 class="fw-bold text-dark mb-2 text-truncate"><%= book.title %></h5>
                        <p class="text-muted small mb-3"><%= book.author %></p>

                        <div class="mt-auto">
                            <a href="/books/read/<%= book._id %>" class="btn-read-now mb-2">
                                <i class="bi bi-book-fill"></i> Đọc ngay
                            </a>

                            <% if (!isAdmin) { %>
                                <form action="/books/buy/<%= book._id %>" method="POST">
                                    <button type="submit" class="btn-buy-now">
                                        <i class="bi bi-cart-plus-fill"></i> Mua ngay
                                    </button>
                                </form>
                            <% } %>
                        </div>

                        <div class="mt-3 pt-3 border-top d-flex justify-content-between text-secondary small">
                            <span><i class="bi bi-calendar3 me-1"></i><%= book.publishYear %></span>
                            <span class="badge bg-light text-dark border"><%= book.category || 'Chưa phân loại' %></span>
                        </div>
                    </div>
                </div>

                <!-- Modal Edit -->
                <% if (isAdmin) { %>
                <div class="modal fade" id="editBookModal<%= book._id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content shadow-lg" style="border-radius: 20px;">
                            <form action="/books/edit/<%= book._id %>" method="POST">
                                <div class="modal-header border-0 pt-4 px-4">
                                    <h5 class="modal-title fw-bold">Cập nhật sách</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Tên sách</label>
                                            <input type="text" name="title" value="<%= book.title %>" class="form-control bg-light" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Tác giả</label>
                                            <input type="text" name="author" value="<%= book.author %>" class="form-control bg-light" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Giá</label>
                                            <input type="number" name="price" value="<%= book.price %>" class="form-control bg-light">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Thể loại</label>
                                            <select name="category" class="form-select bg-light">
                                                <option value="Công nghệ" <%= book.category === 'Công nghệ' ? 'selected' : '' %>>Công nghệ</option>
                                                <option value="Kinh tế" <%= book.category === 'Kinh tế' ? 'selected' : '' %>>Kinh tế</option>
                                                <option value="Văn học" <%= book.category === 'Văn học' ? 'selected' : '' %>>Văn học</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn-primary-custom">Lưu thay đổi</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <% } %>
            <% }) %>
        <% } %>
    </div>
</main>

<!-- ==================== MODAL THÊM SÁCH MỚI (ĐÃ SỬA) ==================== -->
<div class="modal fade" id="addBookModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border-radius: 20px; border: none;">
            <form action="/books/add" method="POST">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Thêm sách mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tên sách</label>
                            <input type="text" name="title" class="form-control bg-light" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tác giả</label>
                            <input type="text" name="author" class="form-control bg-light" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Giá tiền</label>
                            <input type="number" name="price" class="form-control bg-light">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Thể loại</label>
                            <select name="category" class="form-select bg-light">
                                <option value="Công nghệ">Công nghệ</option>
                                <option value="Kinh tế">Kinh tế</option>
                                <option value="Văn học">Văn học</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 px-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-primary-custom">Thêm sách</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.btn-custom-toggle').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const menu = this.nextElementSibling;
                document.querySelectorAll('.custom-dropdown-menu').forEach(m => m.classList.remove('show'));
                menu.classList.toggle('show');
            });
        });

        window.addEventListener('click', () => {
            document.querySelectorAll('.custom-dropdown-menu').forEach(menu => menu.classList.remove('show'));
        });
    });
</script>